def init(module):
    module.name = ":test:platform:mcan"
    module.description = "Tests for SAM MCAN"

def prepare(module, options):
    target = options[":target"]
    if not target.has_driver("mcan:sam*"):
        return False
    if target.identifier.variant == 'a':
        return False

    module.depends(":architecture:delay", ":platform:can:0")
    return True

def build(env):
#    env.substitutions = properties
    env.outbasepath = "modm-test/src/modm-test/platform/can/sam-mcan_test"
    env.copy("mcan_test.hpp")
    env.copy("mcan_test.cpp")
