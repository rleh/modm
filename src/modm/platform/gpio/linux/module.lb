def init(module):
    module.name = ":platform:gpio"
    module.description = "Hosted GPIO on Linux using libgpiod"


def prepare(module, options):
    target = options[":target"].identifier
    if not (target.platform in ["hosted"] and target.family in ["linux"]):
        return False

    module.depends(":architecture:gpio")
    return True


def build(env):
    env.outbasepath = "modm/src/modm/platform/gpio"

    #env.collect(":build:library", "wiringPi")

    env.copy(".")
    env.copy("../common/inverted.hpp", "inverted.hpp")
